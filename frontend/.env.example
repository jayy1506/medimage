# Backend API Endpoint (Relative to use Next.js high-speed proxy without IPv6/CORS stalls)
NEXT_PUBLIC_API_URL=/api/v1

# Firebase Client Configuration (Sample Placeholders)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Hosted Supabase Storage CDN URL for Approved Visuals & Public Sample DICOMs
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-supabase.supabase.co/storage/v1/object/public/visual-assets

# Upstash Redis Serverless Credentials
NEXT_PUBLIC_UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
NEXT_PUBLIC_UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Gemini Configuration (Server-Side Only - Never prefix with NEXT_PUBLIC_)
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.1-flash-lite
ASSISTANT_NAME=Lexi
PROJECT_NAME="Medical Text and Image Processing (MedImage / GyaanLab)"
LEXI_DOMAIN="Questions about the Medical Text and Image Processing (MedImage / GyaanLab) interactive learning platform, including its features, dual-panel topic engine, image playgrounds, assessments, roles, setup, and technical troubleshooting."
